# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=sadc_umsa

# JWT Configuration
JWT_SECRET=super_secret_key
JWT_EXPIRATION=1d

# Application Configuration
PORT=3000
DEBUG=True

# OIDC Configuration
OIDC_ISSUER=https://id.fcpn.edu.bo/realms/your-realm
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://your-backend.com/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://your-frontend.com/
SESSION_SECRET=a-very-strong-secret-for-sessions

# Database Configuration para desarrollo
DB_SYNCHRONIZE=True
DB_ECHO=True

# Database Configuration para producción
DB_SYNCHRONIZE=False
DB_ECHO=False

NODE_ENV=production

# Notifications Scheduler
NOTIFICATION_CRON_TIMEZONE=America/La_Paz
NOTIFICATION_MORNING_HOUR=8
NOTIFICATION_POLL_WINDOW_MINUTES=15

# Mail / SMTP Configuration (Google Workspace FCPN)
# Host: smtp.gmail.com (App Password) o smtp-relay.gmail.com (SMTP relay)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=medportal@fcpn.edu.bo
MAIL_PASS=
MAIL_FROM="MedPortal <medportal@fcpn.edu.bo>"

# Frontend URL (links de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
